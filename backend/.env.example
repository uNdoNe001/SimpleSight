# SimpleSight backend configuration (copy to .env; never commit .env)

APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://simplesight:simplesight@localhost:5432/simplesight

# Redis (job queue + cache)
REDIS_URL=redis://localhost:6379/0

# Object storage for evidence/report artifacts (S3-compatible)
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=simplesight-evidence
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# --- OSINT provider API keys (injected into workers; never returned to clients) ---
# Populate as collectors are implemented. Missing keys cause a collector to be
# reported as "skipped" rather than failing the whole investigation.
# CT_LOG_API_KEY=
# PASSIVE_DNS_API_KEY=
# TECH_FINGERPRINT_API_KEY=
