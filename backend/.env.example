# SimpleSight backend configuration (copy to .env; never commit .env)

APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg2://simplesight:simplesight@localhost:5432/simplesight
# Dev convenience: create tables on startup. Set false in production and run Alembic
# migrations instead (`alembic upgrade head`).
AUTO_CREATE_TABLES=true

# Redis (job queue + cache)
REDIS_URL=redis://localhost:6379/0

# Job queue. QUEUE_EAGER=true runs collection inline in the API process (no Redis/worker
# needed) — handy for local dev. Leave false to use the RQ worker.
QUEUE_EAGER=false
COLLECTION_QUEUE=collection

# Secrets-at-rest encryption (SMPLSGHT-11). Fernet key: url-safe base64, 32 bytes.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be overridden in every real environment; rotating it makes stored secrets unreadable.
SECRETS_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
# SECRET_ENV_PREFIX=SIMPLESIGHT_SECRET_

# Object storage for evidence/report artifacts (S3-compatible)
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=simplesight-evidence
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# --- OSINT provider API keys (SMPLSGHT-11) ---
# Preferred path: set per-tenant keys via the admin API (PUT /api/secrets/{name}); they
# are stored encrypted at rest and resolved into a collector's config at run time.
# As a shared fallback, a key may be provided here as SIMPLESIGHT_SECRET_<NAME>, e.g.:
# SIMPLESIGHT_SECRET_SHODAN_API_KEY=
# Missing keys cause the dependent collector to be "skipped", not failed.
